// Tableau calc field 경량 문법 (Lark).
// 목적: 함수 호출(rule ①)과 필드 참조(rule ②) 추출.
// 전체 평가기가 아니다 — 검증에 필요한 토큰만 안전하게 잡는다.
//
// 스캐폴딩 단계 = 최소 뼈대. 구현 단계에서 연산자·리터럴·LOD({FIXED ...})
// ·주석 처리를 정밀화한다.

start: expr

?expr: func_call
     | field_ref
     | NAME
     | NUMBER
     | STRING

func_call: NAME "(" [expr ("," expr)*] ")"

// 필드 참조: [Field] 또는 [datasource].[Field]
field_ref: BRACKET ("." BRACKET)*

BRACKET: /\[[^\]]*\]/
NAME: /[A-Za-z_][A-Za-z0-9_]*/
STRING: /"[^"]*"/ | /'[^']*'/
NUMBER: /-?\d+(\.\d+)?/

// 주석: // 라인 주석
COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
